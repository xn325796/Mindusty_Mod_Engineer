// Default planet template, derived from vanilla serpulo's data in Planets.java (v160.5).
// Applied automatically to newly created planets.
//
// Notes:
// - serpulo's own HexMesh is not parseable from JSON (the game's parseMesh switch only accepts
//   NoiseMesh / SunMesh / HexSkyMesh / MultiMesh / MatMesh), so the surface mesh uses NoiseMesh
//   with a serpulo-like green/blue palette.
// - generator, ruleSetter and sectorCaptureReplacements are Java-side lambdas and cannot be
//   expressed in JSON; they are intentionally omitted.
// - cloud colors are computed from Pal.spore ("7457ce"): cloud 1 = spore*0.9 @0.75 alpha,
//   cloud 2 = white lerp spore 0.55 @0.75 alpha, landCloudColor = spore @0.5 alpha.
{
  "parent": "sun",
  "radius": 1,
  "sectorSize": 3,
  "startSector": 170,
  "sectorSeed": 2,
  "alwaysUnlocked": true,
  "allowWaves": true,
  "allowSectorInvasion": true,
  "allowLaunchSchematics": true,
  "allowLaunchLoadout": true,
  "allowSelfSectorLaunch": true,
  "allowLegacyLaunchPads": true,
  "enemyCoreSpawnReplace": true,
  "showRtsAIRule": true,
  "launchCapacityMultiplier": 0.5,
